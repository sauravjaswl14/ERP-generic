DATABASE_URL="postgresql://erp:erp@localhost:5432/erp?schema=public"
PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES="8h"
CLIENT_ORIGIN="http://localhost:5173"
