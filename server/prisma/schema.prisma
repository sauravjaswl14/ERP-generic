generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Enums ─────────────
enum Role {
  ADMIN
  MANAGER
  HR
  SALES
  PURCHASING
  INVENTORY
  ACCOUNTANT
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  MATERNITY
  OTHER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

enum PayrollStatus {
  DRAFT
  PAID
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum MovementType {
  IN
  OUT
  ADJUST
  TRANSFER_IN
  TRANSFER_OUT
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  VOID
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ───────────── Core / Admin ─────────────
// Every other model carries a tenantId. The Prisma client in src/lib/prisma.ts filters and stamps it
// automatically, and src/lib/tenant-scope.test.ts fails if a model is added without being registered.
model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  auditLogs          AuditLog[]
  sequences          Sequence[]
  departments        Department[]
  employees          Employee[]
  leaveRequests      LeaveRequest[]
  attendances        Attendance[]
  payrolls           Payroll[]
  customers          Customer[]
  leads              Lead[]
  products           Product[]
  warehouses         Warehouse[]
  stockLevels        StockLevel[]
  stockMovements     StockMovement[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderLines PurchaseOrderLine[]
  salesOrders        SalesOrder[]
  salesOrderLines    SalesOrderLine[]
  invoices           Invoice[]
  payments           Payment[]
  accounts           Account[]
  journalEntries     JournalEntry[]
  journalLines       JournalLine[]
  projects           Project[]
  tasks              Task[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String   @default("") // set by the tenant-scoped client; "" fails the foreign key
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String
  name         String
  passwordHash String
  role         Role     @default(EMPLOYEE)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  managedProjects Project[]  @relation("ProjectManager")
  assignedTasks   Task[]     @relation("TaskAssignee")
  leads           Lead[]     @relation("LeadOwner")
  auditLogs       AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String   @default("") // set by the tenant-scoped client; "" fails the foreign key
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([tenantId])
}

model Sequence {
  key      String
  tenantId String @default("") // set by the tenant-scoped client; "" fails the foreign key
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  value    Int    @default(0)

  @@id([tenantId, key])
  @@index([tenantId])
}

// ───────────── HR ─────────────
model Department {
  id          String     @id @default(uuid())
  tenantId    String     @default("") // set by the tenant-scoped client; "" fails the foreign key
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  code        String
  name        String
  description String?
  employees   Employee[]
  createdAt   DateTime   @default(now())

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Employee {
  id           String         @id @default(uuid())
  tenantId     String         @default("") // set by the tenant-scoped client; "" fails the foreign key
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  code         String
  firstName    String
  lastName     String
  email        String
  phone        String?
  position     String
  hireDate     DateTime
  salary       Decimal        @db.Decimal(14, 2)
  status       EmployeeStatus @default(ACTIVE)
  departmentId String?
  department   Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  managerId    String?
  manager      Employee?      @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports      Employee[]     @relation("EmployeeManager")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  leaves     LeaveRequest[]
  attendance Attendance[]
  payrolls   Payroll[]

  @@unique([tenantId, code])
  @@unique([tenantId, email])
  @@index([departmentId])
  @@index([tenantId])
}

model LeaveRequest {
  id         String        @id @default(uuid())
  tenantId   String        @default("") // set by the tenant-scoped client; "" fails the foreign key
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       LeaveType     @default(ANNUAL)
  startDate  DateTime
  endDate    DateTime
  status     RequestStatus @default(PENDING)
  reason     String?
  createdAt  DateTime      @default(now())

  @@index([employeeId])
  @@index([tenantId])
}

model Attendance {
  id         String           @id @default(uuid())
  tenantId   String           @default("") // set by the tenant-scoped client; "" fails the foreign key
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus @default(PRESENT)

  @@unique([employeeId, date])
  @@index([tenantId])
}

model Payroll {
  id         String        @id @default(uuid())
  tenantId   String        @default("") // set by the tenant-scoped client; "" fails the foreign key
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period     String // YYYY-MM
  basic      Decimal       @db.Decimal(14, 2)
  allowances Decimal       @default(0) @db.Decimal(14, 2)
  deductions Decimal       @default(0) @db.Decimal(14, 2)
  net        Decimal       @db.Decimal(14, 2)
  status     PayrollStatus @default(DRAFT)
  paidAt     DateTime?
  createdAt  DateTime      @default(now())

  @@unique([employeeId, period])
  @@index([tenantId])
}

// ───────────── CRM ─────────────
model Customer {
  id          String   @id @default(uuid())
  tenantId    String   @default("") // set by the tenant-scoped client; "" fails the foreign key
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  email       String?
  phone       String?
  address     String?
  taxId       String?
  creditLimit Decimal  @default(0) @db.Decimal(14, 2)
  createdAt   DateTime @default(now())

  salesOrders SalesOrder[]
  invoices    Invoice[]

  @@index([tenantId])
}

model Lead {
  id        String     @id @default(uuid())
  tenantId  String     @default("") // set by the tenant-scoped client; "" fails the foreign key
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  name      String
  company   String?
  email     String?
  phone     String?
  source    String?
  status    LeadStatus @default(NEW)
  value     Decimal    @default(0) @db.Decimal(14, 2)
  notes     String?
  ownerId   String?
  owner     User?      @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())

  @@index([tenantId])
}

// ───────────── Inventory ─────────────
model Product {
  id           String   @id @default(uuid())
  tenantId     String   @default("") // set by the tenant-scoped client; "" fails the foreign key
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  sku          String
  name         String
  category     String?
  description  String?
  unit         String   @default("pcs")
  unitPrice    Decimal  @default(0) @db.Decimal(14, 2)
  costPrice    Decimal  @default(0) @db.Decimal(14, 2)
  reorderLevel Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  stock         StockLevel[]
  movements     StockMovement[]
  salesLines    SalesOrderLine[]
  purchaseLines PurchaseOrderLine[]

  @@unique([tenantId, sku])
  @@index([tenantId])
}

model Warehouse {
  id       String  @id @default(uuid())
  tenantId String  @default("") // set by the tenant-scoped client; "" fails the foreign key
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  code     String
  name     String
  location String?

  stock          StockLevel[]
  movements      StockMovement[]
  salesOrders    SalesOrder[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model StockLevel {
  id          String    @id @default(uuid())
  tenantId    String    @default("") // set by the tenant-scoped client; "" fails the foreign key
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)

  @@unique([productId, warehouseId])
  @@index([tenantId])
}

model StockMovement {
  id          String       @id @default(uuid())
  tenantId    String       @default("") // set by the tenant-scoped client; "" fails the foreign key
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  type        MovementType
  quantity    Int // signed for ADJUST, positive otherwise
  reference   String?
  note        String?
  createdById String?
  createdAt   DateTime     @default(now())

  @@index([productId])
  @@index([createdAt])
  @@index([tenantId])
}

// ───────────── Purchasing ─────────────
model Supplier {
  id        String   @id @default(uuid())
  tenantId  String   @default("") // set by the tenant-scoped client; "" fails the foreign key
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  email     String?
  phone     String?
  address   String?
  taxId     String?
  createdAt DateTime @default(now())

  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  tenantId     String              @default("") // set by the tenant-scoped client; "" fails the foreign key
  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  number       String
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  warehouseId  String
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id])
  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  taxRate      Decimal             @default(0) @db.Decimal(5, 2)
  subtotal     Decimal             @db.Decimal(14, 2)
  tax          Decimal             @default(0) @db.Decimal(14, 2)
  total        Decimal             @db.Decimal(14, 2)
  paidAt       DateTime?
  notes        String?
  createdById  String?
  createdAt    DateTime            @default(now())

  lines PurchaseOrderLine[]

  @@unique([tenantId, number])
  @@index([tenantId])
}

model PurchaseOrderLine {
  id              String        @id @default(uuid())
  tenantId        String        @default("") // set by the tenant-scoped client; "" fails the foreign key
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  unitCost        Decimal       @db.Decimal(14, 2)
  lineTotal       Decimal       @db.Decimal(14, 2)

  @@index([tenantId])
}

// ───────────── Sales ─────────────
model SalesOrder {
  id          String           @id @default(uuid())
  tenantId    String           @default("") // set by the tenant-scoped client; "" fails the foreign key
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  number      String
  customerId  String
  customer    Customer         @relation(fields: [customerId], references: [id])
  warehouseId String
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])
  status      SalesOrderStatus @default(DRAFT)
  orderDate   DateTime         @default(now())
  taxRate     Decimal          @default(0) @db.Decimal(5, 2)
  subtotal    Decimal          @db.Decimal(14, 2)
  tax         Decimal          @default(0) @db.Decimal(14, 2)
  total       Decimal          @db.Decimal(14, 2)
  notes       String?
  createdById String?
  createdAt   DateTime         @default(now())

  lines   SalesOrderLine[]
  invoice Invoice?

  @@unique([tenantId, number])
  @@index([tenantId])
}

model SalesOrderLine {
  id           String     @id @default(uuid())
  tenantId     String     @default("") // set by the tenant-scoped client; "" fails the foreign key
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Int
  unitPrice    Decimal    @db.Decimal(14, 2)
  discount     Decimal    @default(0) @db.Decimal(5, 2)
  lineTotal    Decimal    @db.Decimal(14, 2)

  @@index([tenantId])
}

model Invoice {
  id           String        @id @default(uuid())
  tenantId     String        @default("") // set by the tenant-scoped client; "" fails the foreign key
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  number       String
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id])
  salesOrderId String?       @unique
  salesOrder   SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  issueDate    DateTime      @default(now())
  dueDate      DateTime
  total        Decimal       @db.Decimal(14, 2)
  paid         Decimal       @default(0) @db.Decimal(14, 2)
  status       InvoiceStatus @default(UNPAID)
  createdAt    DateTime      @default(now())

  payments Payment[]

  @@unique([tenantId, number])
  @@index([tenantId])
}

model Payment {
  id        String   @id @default(uuid())
  tenantId  String   @default("") // set by the tenant-scoped client; "" fails the foreign key
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(14, 2)
  method    String   @default("BANK")
  reference String?
  date      DateTime @default(now())

  @@index([tenantId])
}

// ───────────── Accounting ─────────────
model Account {
  id          String      @id @default(uuid())
  tenantId    String      @default("") // set by the tenant-scoped client; "" fails the foreign key
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  code        String
  name        String
  type        AccountType
  description String?
  isActive    Boolean     @default(true)

  lines JournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model JournalEntry {
  id          String   @id @default(uuid())
  tenantId    String   @default("") // set by the tenant-scoped client; "" fails the foreign key
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  number      String
  date        DateTime @default(now())
  description String
  reference   String?
  createdById String?
  createdAt   DateTime @default(now())

  lines JournalLine[]

  @@unique([tenantId, number])
  @@index([tenantId])
}

model JournalLine {
  id        String       @id @default(uuid())
  tenantId  String       @default("") // set by the tenant-scoped client; "" fails the foreign key
  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  entryId   String
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account   Account      @relation(fields: [accountId], references: [id])
  debit     Decimal      @default(0) @db.Decimal(14, 2)
  credit    Decimal      @default(0) @db.Decimal(14, 2)
  memo      String?

  @@index([accountId])
  @@index([tenantId])
}

// ───────────── Projects ─────────────
model Project {
  id          String        @id @default(uuid())
  tenantId    String        @default("") // set by the tenant-scoped client; "" fails the foreign key
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  code        String
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal       @default(0) @db.Decimal(14, 2)
  managerId   String?
  manager     User?         @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  tasks Task[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Task {
  id          String     @id @default(uuid())
  tenantId    String     @default("") // set by the tenant-scoped client; "" fails the foreign key
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())

  @@index([projectId])
  @@index([tenantId])
}
